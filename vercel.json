{
  "version": 2,
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/config.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/config", "destination": "/api/config.ts" },
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/trpc/:path*", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
