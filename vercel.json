{
  "version": 2,
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/config.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/execute-tasks",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path+", "destination": "/api/index.js" },
    { "source": "/trpc/:path+", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
