# Firebase browser configuration. Set these in Vercel and local .env files; never commit actual values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Hanna default Gemini configuration. Server-side only; do not expose in Vite/client code.
GEMINI_API_KEY=
GEMINI_MODEL=

# AES-256-GCM key used to encrypt connector credentials at rest (32+ byte secret).
CREDENTIAL_ENCRYPTION_KEY=
# Alias accepted by credentialCrypto
HANNA_ENCRYPTION_KEY=

# Public base URL of this app (used for OAuth redirect_uri).
APP_BASE_URL=https://hanna-agent.vercel.app

# Optional dedicated secret for signing OAuth state (falls back to CREDENTIAL_ENCRYPTION_KEY).
# REQUIRED in production — never use a hard-coded dev secret on Vercel.
OAUTH_STATE_SECRET=

# --- OAuth client credentials (server-side only) ---
# Create apps in each provider console and set the redirect URI to:
#   https://hanna-agent.vercel.app/api/oauth/{provider}/callback
# Providers: google | github | slack | meta | shopify | x | tiktok

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=

X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=

# Groq (Hanna Fast / Instant / Advanced models) — server-side only
GROQ_API_KEY=
