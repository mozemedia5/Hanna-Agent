# Firebase browser configuration. Set these in the deployment environment and local .env files; never commit actual values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Hanna default Gemini configuration. Server-side only; do not expose in Vite/client code.
GEMINI_API_KEY=
GEMINI_MODEL=

# Shopify OAuth app credentials. Server-side only; never expose these in browser code.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Register this exact URL in the Shopify app settings; defaults to APP_BASE_URL/api/oauth/shopify/callback.
SHOPIFY_REDIRECT_URI=
APP_BASE_URL=
# Required for signed OAuth state and encrypted connector credential storage.
OAUTH_STATE_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
